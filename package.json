{
  "name": "sticktalk-studio",
  "productName": "StickTalk Studio",
  "version": "2.0.0",
  "description": "Studio Sản Xuất Hoạt Hình Người Que Đỉnh Cao Dành Cho Giáo Dục & Video Ngắn",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port=3050 --host=0.0.0.0",
    "server": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "app": "electron . --no-sandbox",
    "build:app": "npm run build && electron-packager . \"StickTalk-Studio\" --platform=linux --arch=x64 --out=dist-app --overwrite --icon=public/icon.png --ignore=\"^/(scratch|tests|\\.git)\"",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-app",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.18.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mp4-muxer": "^5.2.2",
    "playwright-core": "^1.63.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.1",
    "vite": "^6.2.3",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
