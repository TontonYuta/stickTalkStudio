    {
      "id": "db-4",
      "characterId": "char-mentor",
      "text": "Ở Chặng 1 (Tuần 1 đến 4), em phải thiết kế kiến trúc 2 tầng và xây dựng bộ benchmark 150 test cases chuẩn khoa học.",
      "startTime": 15.5,
      "duration": 5.2,
