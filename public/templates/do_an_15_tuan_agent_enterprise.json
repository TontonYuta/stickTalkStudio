      "emotion": "questioning",
      "bubbleType": "normal",
      "boxStyle": "card",
      "roleIcon": "🎓"
    },
    {
      "id": "db-3",
      "characterId": "char-mentor",
      "text": "Chính xác! Điểm nghẽn 1 là Ảo giác (Hallucination), và điểm nghẽn 2 là Thiếu năng lực tương tác công cụ ngoại vi!",
      "startTime": 10.2,
      "duration": 4.8,
      "emotion": "explaining",
      "bubbleType": "normal",
      "boxStyle": "card",
      "roleIcon": "👨‍🏫"
